// ============================================================
// GlobIQ — Prisma Schema
// Governing spec: GlobIQ_Master_Plan.md (v2.0) — Sections 6, 14, 35
//
// P1-S1 scope (this file): database switch to PostgreSQL (Supabase) +
// foundation models: Language, Country, CountryLanguage, base User.
//
// Upcoming (do NOT add early — see Master Plan §41/§48 session protocol):
//   P3-S4: multi-exam union engine (computed — no new tables per §11/§46.3)
//   P5+:   UserFollow, SavedItem, CurrentEvent, Question, MockTest, …
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Named GLOBIQ_DATABASE_URL (not DATABASE_URL) deliberately: the deployment
  // environment may inject a stale DATABASE_URL — this variable is always
  // sourced from .env (dev) or the hosting dashboard (Vercel).
  url      = env("GLOBIQ_DATABASE_URL")
}

// ---------- Enums ----------

enum LanguageDirection {
  LTR
  RTL
}

enum LanguageStatus {
  ACTIVE
  INACTIVE
}

enum CountryStatus {
  ACTIVE
  COMING_SOON
  INACTIVE
}

// P1-S2 (§6, §20, §38): roles are platform-level; country/language scoping for
// privileged roles is enforced per-operation from P1-S5 onward.
// P1-S5: scoping is enforced via src/lib/permissions.ts on every protected
// operation (§20: "The authorization service checks those scopes on every
// protected operation") — not by hiding UI elements.
enum UserRole {
  READER
  WRITER
  COUNTRY_ADMIN
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuthMethod {
  PASSWORD
}

// P5-S1 (§6 UserFollow row, §10): the object types a user can follow today.
// Extension is additive — ENTITY joined in P6-S3 (§10 "entity" is a listed
// followable); current-affairs themes are taxonomy nodes and already ride
// TOPIC (the §13 Current Affairs domain).
enum FollowObjectType {
  EXAM
  TOPIC
  ENTITY // P6-S3 (§6 Entity row, §10): persons/places/organisations/concepts
}

// P1-S4 (§13): one global taxonomy framework — nodes carry stable IDs,
// parent/child links, aliases, descriptions, country applicability, language
// labels and status. Exam names never enter the taxonomy (they map only via
// SyllabusNode → ExamMapping in P3).
enum TopicNodeType {
  DOMAIN // configurable root domain (History, Polity, Economy, …) — §13
  BRANCH // intermediate grouping node
  TOPIC // granular teachable/followable topic
}

enum TopicStatus {
  ACTIVE
  INACTIVE // temporarily hidden (e.g. under review)
  RETIRED // soft-deleted, end-of-life (§36: migration-safe, no hard deletes)
}

enum TopicScope {
  GLOBAL // part of the single global framework (§13)
  COUNTRY // country-specific extension
}

// ---------- P2-S1: KnowledgeUnit (Master Plan §6, §7, §14, §23, §36) ----------

// Canonical knowledge type (§23 canonical content types — assessment formats
// QnA/Question/MockTest are separate entities referencing a KnowledgeUnit,
// never types of it; representation formats like explainer/current-event/notes
// are ContentItem formats, P2-S2).
enum KnowledgeUnitType {
  FACT
  CONCEPT
  TIMELINE
  PERSON_PROFILE
  PLACE_PROFILE
  ORGANISATION_PROFILE
  COMPARISON
}

// Lifecycle states (§6 + P2-S1 session scope). The full editorial workflow
// (§19 review gates, Senior Editor/Fact Checker roles) lands in P2-S4; this
// is the KnowledgeUnit's own state machine. Public visibility = VERIFIED only.
enum KnowledgeStatus {
  DRAFT // being authored; full edit; not public
  IN_REVIEW // submitted for verification; full edit; not public
  VERIFIED // canonical truth; publicly visible; body locked (§36 no silent edits)
  OUTDATED // flagged for correction (feedback/event); body editable again
  ARCHIVED // end-of-life; read-only, like RETIRED taxonomy nodes (§36)
}

// Difficulty (§6 row: "difficulty") — the canonical knowledge's inherent level;
// per-exam required_depth is ExamMapping (P3), a different dimension.
enum KnowledgeDifficulty {
  BASIC
  INTERMEDIATE
  ADVANCED
}

// The canonical semantic record (§7): the reusable "thing to know", stored
// ONCE. Country/language/format/depth are rendering dimensions — representations
// (ContentItem, QnA, Question) reference this record from P2-S2 onward and are
// NEVER re-entered facts. Country scope is explicit, never inferred (§14/§15).
model KnowledgeUnit {
  id               String              @id @default(cuid())
  slug             String              @unique // immutable, URL-stable (§16/§36)
  canonicalName    String // canonical (English-reference) name
  canonicalSummary String? // one-line essence — the "quick fact" (§22 knowledge page)
  canonicalBody    String // canonical body (English-reference); language versions are ContentItems (P2-S2)
  type             KnowledgeUnitType
  status           KnowledgeStatus     @default(DRAFT)
  difficulty       KnowledgeDifficulty @default(BASIC)
  scope            TopicScope          @default(GLOBAL) // platform-wide GLOBAL/COUNTRY scope concept (§14)
  countryId        String? // set iff scope = COUNTRY (explicit, never inferred)
  topicId          String // canonical taxonomy topic (§13) — primary node
  validFrom        DateTime? // time validity window (§6 "validity")
  validUntil       DateTime?
  notes            String? // internal editorial notes
  orderIndex       Int                 @default(0) // stable ordering within a topic
  createdById      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  topic        Topic                       @relation("KnowledgeUnitTopic", fields: [topicId], references: [id])
  country      Country?                    @relation("KnowledgeUnitCountry", fields: [countryId], references: [id])
  createdBy    User?                       @relation("KnowledgeUnitAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  contentItems ContentItem[] // representations of this canonical record (§7, P2-S2)
  examMappings ExamMapping[]               @relation("ExamMappingUnit") // P3-S3 requirement layer (§8)
  eventLinks   CurrentEventKnowledgeUnit[] // P6-S1: events pointing at this canonical truth (§12 step 3)
  qnas         QnA[]                       @relation("QnAUnit") // P7-S1: explanatory Q&A representations (§22 QnA layer)
  questions    Question[]                  @relation("QuestionUnit") // P7-S2: scored MCQ assessment representations (§22 practice layer)
  masteryStates MasteryState[]             @relation("UnitMastery") // P7-S4: derived per-user proficiency rows (§6/§22)

  // Deduplication is by canonical identity (§11): within one topic, a canonical
  // name identifies exactly one unit. Never merge distinct concepts; never
  // duplicate identical ones.
  @@unique([topicId, canonicalName])
  @@index([status])
  @@index([scope, countryId])
  @@index([topicId, status])
  @@index([type])
}

// ---------- P2-S2: ContentItem + revisions (Master Plan §6, §7, §19, §23, §35, §36) ----------

// Representation formats (§23) — HOW a canonical record is rendered. The
// canonical semantic type (FACT/CONCEPT/TIMELINE/…) lives on KnowledgeUnit;
// QnA/Question/MockTest are separate entities (P7, §6 correction) — they are
// never ContentItem formats. Each format has its own validation rules
// (content-validation.ts) — no single unstructured HTML blob (§23 anti-pattern).
enum ContentFormat {
  FACT_CARD // quick-fact rendering (§22 quick fact layer)
  EXPLAINER // detailed article
  REVISION_NOTE // compact revision notes
  CURRENT_EVENT_UPDATE // source-backed update (Source model itself is P2-S3)
  TIMELINE // timeline rendering
  PROFILE // person/place/organisation profile rendering
  COMPARISON // comparison rendering
}

// Lifecycle (§19 workflow). P2-S4 adds the editorial workspace: SCHEDULED is
// the approved-for-future-release state (§19 step 7 "Scheduled or immediate
// publish") — reached from IN_REVIEW via `schedule` with a future
// scheduledForAt; the working copy is locked (what was reviewed is what
// publishes); due items materialize to PUBLISHED lazily on read. PUBLISHED
// content is immutable at the revision level: the public surface always reads
// the live ContentRevision snapshot; corrections edit the working copy and
// publish a NEW revision (§36 — previous versions preserved forever).
enum ContentStatus {
  DRAFT // being authored; not public
  IN_REVIEW // submitted for editorial review (§19 step 2)
  SCHEDULED // approved for release at scheduledForAt (§19 step 7) — working copy locked
  PUBLISHED // live; public reads the live revision snapshot
  RETIRED // withdrawn/archived end-of-life (§19 step 10) — read-only, like ARCHIVED
}

// ---------- P2-S3: Source & provenance (Master Plan §6 Source row, §24, §26) ----------

// §24 "source category" (the §6 Source row calls it "source type") — what kind
// of evidence the record points at. Configurable vocabulary; these values are
// the launch set.
enum SourceType {
  OFFICIAL // government/constitutional/official-body material (PIB, ISRO, judgments)
  NEWS_MEDIA // newspapers, wires, broadcast reporting
  INSTITUTIONAL // institutional reports & repositories (UN, World Bank, RBI)
  ACADEMIC // journals, books, scholarly work
  DATA // statistical databases and datasets
  OTHER
}

// §24 "Editor verification state" — the editorial trust decision on a piece
// of evidence. Sources are never deleted (§36 migration-safe philosophy):
// a bad source is marked UNRELIABLE, and its links remain as preserved
// provenance history.
enum SourceVerification {
  UNVERIFIED // recorded, not yet editor-checked
  VERIFIED // an editor confirmed the evidence (verifiedAt set)
  UNRELIABLE // flagged unreliable/retracted — trust revoked
}

// The publishable representation (§7): one canonical record's truth rendered
// in ONE language and ONE format. Since P6-S2 a ContentItem represents EITHER
// a KnowledgeUnit (§7 — the knowledge layer) OR a CurrentEvent (§12 step 4 —
// "create language-specific ContentItems for explanation": the event's
// language-specific explanations ride the SAME §19 workflow, §36 revision
// history and §24 provenance as unit representations; writers with
// content:manage enter the current-affairs flow here). Exactly one anchor is
// set — the XOR invariant is enforced by validation + the service. Identity
// (anchor + language + format) is immutable post-create — the same
// migration-safe philosophy as the KU slug. title/body are the WORKING COPY
// (editorial staging); published snapshots live only in ContentRevision.
// Country scope is inherited from the anchor (unit or event) — a
// representation is never more visible than its canonical record.
model ContentItem {
  id                  String        @id @default(cuid())
  // §7 anchor (knowledge representations) — null iff currentEventId is set.
  knowledgeUnitId     String?
  // §12 step 4 anchor (event representations, P6-S2) — null iff
  // knowledgeUnitId is set. The event is the canonical record: the exam
  // layer flows through the event's linked units (§7/§8), never through
  // re-entered facts.
  currentEventId      String?
  languageId          String
  format              ContentFormat
  status              ContentStatus @default(DRAFT)
  title               String // working copy (current editing state)
  body                String // working copy — public reads never touch this
  // §24/§26 AI-provenance flag (working copy): marks AI-assisted drafting.
  // Snapshotted onto ContentRevision at publish time so every immutable
  // revision carries its own provenance.
  aiAssisted          Boolean       @default(false)
  publishedRevisionId String? // live revision pointer (null = never published)
  // §19 step 7 (P2-S4): set by the `schedule` transition (IN_REVIEW →
  // SCHEDULED); cleared on send_back/publish. Due items are lazily
  // materialized to PUBLISHED on read (see content-service).
  scheduledForAt      DateTime?
  createdById         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  knowledgeUnit     KnowledgeUnit?      @relation(fields: [knowledgeUnitId], references: [id])
  currentEvent      CurrentEvent?       @relation("ContentItemEvent", fields: [currentEventId], references: [id], onDelete: Cascade)
  language          Language            @relation(fields: [languageId], references: [id])
  createdBy         User?               @relation("ContentItemAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  revisions         ContentRevision[]   @relation("ContentItemRevisions")
  publishedRevision ContentRevision?    @relation("LiveContentRevision", fields: [publishedRevisionId], references: [id])
  sourceLinks       ContentSourceLink[]

  // One representation per (anchor, language, format) — the §7/§11 canonical-
  // identity rule applied to representations: never duplicate the same
  // rendering; a second explainer in the same language is duplication. The DB
  // constraint fully covers unit-anchored items; event-anchored items carry a
  // NULL knowledgeUnitId, which Postgres treats as distinct in unique
  // indexes — their (event, language, format) uniqueness is enforced by the
  // service with the same REPRESENTATION_EXISTS 409 (P6-S2).
  @@unique([knowledgeUnitId, languageId, format])
  @@index([status])
  @@index([knowledgeUnitId, status])
  @@index([currentEventId, status])
  @@index([languageId, status])
}

// Immutable published snapshot (§36 "Published content revisions preserve
// previous versions"). Rows are NEVER updated or deleted — publishing again
// appends revision N+1 and moves the ContentItem's live pointer. Every
// correction carries a changeSummary (§25/§36 provenance — never a silent edit).
model ContentRevision {
  id             String   @id @default(cuid())
  contentItemId  String
  revisionNumber Int // 1-based, deterministic within the item
  title          String // immutable snapshot at publish time
  body           String // immutable snapshot at publish time
  changeSummary  String? // why this revision exists (required on re-publish)
  // §24/§26 AI-provenance snapshot at publish time — immutable like the rest
  // of the revision ("any AI-generated field that affects factual publishing
  // carries provenance/status metadata").
  aiAssisted     Boolean  @default(false)
  publishedById  String?
  publishedAt    DateTime @default(now())

  contentItem ContentItem   @relation("ContentItemRevisions", fields: [contentItemId], references: [id], onDelete: Cascade)
  publishedBy User?         @relation("ContentRevisionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  liveFor     ContentItem[] @relation("LiveContentRevision")

  @@unique([contentItemId, revisionNumber])
  @@index([contentItemId, publishedAt])
}

// Evidence/provenance record (§6 Source row, §24): one canonical row per
// normalized URL — two content objects citing the same URL share the SAME
// Source record (the §11 dedup philosophy applied to evidence). Metadata
// corrections are edits to the record; the verification workflow is a small
// state machine (UNVERIFIED → VERIFIED/UNRELIABLE, re-checkable) owned by
// source-service.ts. Sources are platform-level shared evidence — country
// scope is enforced on the LINK (which content may cite it), never on the
// record itself.
model Source {
  id           String             @id @default(cuid())
  title        String // human label, e.g. "ISRO — Chandrayaan-3 soft-landing update"
  publisher    String // §24 publisher/name, e.g. "ISRO", "The Hindu"
  url          String             @unique // normalized — one record per URL
  type         SourceType
  verification SourceVerification @default(UNVERIFIED)
  publishedAt  DateTime? // when the underlying material was published (§24)
  retrievedAt  DateTime // when GlobIQ editors retrieved it (§24)
  verifiedAt   DateTime? // when an editor verified it (§24 — set on 'verify')
  notes        String? // internal editorial notes
  createdById  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  createdBy  User?                @relation("SourceAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  links      ContentSourceLink[]
  eventLinks CurrentEventSource[] // P6-S1: §12 step 2 source aggregation

  @@index([type])
  @@index([verification])
  @@index([publisher])
}

// §24 "Claim-level or content-level attribution where needed": the join
// between a publishable representation and its evidence. `claim` null = the
// source backs the whole item (content-level); a string = it backs that
// specific claim. Links are live provenance metadata on the item — every
// attach/detach/edit is audited, and public reads expose current links with
// each source's verification state (the §24 transparency surface).
model ContentSourceLink {
  id            String   @id @default(cuid())
  contentItemId String
  sourceId      String
  claim         String? // claim-level attribution (§24); null = content-level
  createdAt     DateTime @default(now())

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  source      Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([contentItemId, sourceId])
  @@index([sourceId])
}

// ---------- P2-S4: Editorial workspace & workflow (Master Plan §6 EditorialTask
// row, §18 editorial roles, §19 workflow, §20 staff scopes, §38) ----------

// §19 workflow steps the task can represent (configurable vocabulary). Steps
// 2–6 are review types; CORRECTION is the §25/§19-step-9 quality loop
// (public ContentFeedback wires into it in P8-S3); EXAM_MAPPING_REVIEW is used
// from P3 onward. GENERAL = any other editorial work item.
enum EditorialTaskType {
  EDITORIAL_REVIEW // §19 step 2 — editorial review of submitted content
  FACT_CHECK // §19 step 3 — fact/source verification (§24 Source records)
  LOCALISATION_REVIEW // §19 step 5 — language/localisation review
  SEO_REVIEW // §19 step 6 — metadata/indexability review
  EXAM_MAPPING_REVIEW // §19 step 4 — exam mapping review (used from P3)
  CORRECTION // §19 step 9 / §25 — correction work triggered by feedback
  GENERAL
}

// Task lifecycle. OPEN (created, waiting) → IN_PROGRESS (claimed/started) →
// RESOLVED (done) or CANCELLED (abandoned). RESOLVED/CANCELLED can be reopened
// by editors (a reopened task returns to OPEN, clearing resolution fields).
// Tasks are never deleted (§36 migration-safe philosophy).
enum EditorialTaskStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum EditorialTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// §6 EditorialTask row: "id, country, language, type, object_id, assignee,
// status". The work object is a polymorphic reference (objectType + objectId —
// ContentItem today; Questions/MockTests join in P7) with a stable display
// label snapshot. countryId null = platform/global work (§14) — visible to
// ADMIN only, like all global objects. Every task mutation is audited (§19).
model EditorialTask {
  id             String                @id @default(cuid())
  type           EditorialTaskType
  status         EditorialTaskStatus   @default(OPEN)
  priority       EditorialTaskPriority @default(MEDIUM)
  countryId      String? // null = platform/global task (ADMIN-only workspace)
  languageId     String? // optional language dimension (§6 row)
  objectType     String // polymorphic work-object type, e.g. "ContentItem"
  objectId       String
  objectLabel    String // stable snapshot for display, e.g. "slug/en/FACT_CARD"
  title          String // short, human-readable task title
  notes          String? // editor notes / instructions
  resolutionNote String? // outcome recorded on resolve
  assigneeId     String?
  createdById    String?
  dueAt          DateTime?
  startedAt      DateTime?
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  country    Country?  @relation(fields: [countryId], references: [id])
  language   Language? @relation(fields: [languageId], references: [id])
  assignee   User?     @relation("EditorialTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy  User?     @relation("EditorialTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  resolvedBy User?     @relation("EditorialTaskResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  // P8-S3 (§25): the ContentFeedback report this CORRECTION task was opened
  // by (nullable — most tasks are not feedback-routed; unique on the report
  // side: one report, one task).
  feedbackReport ContentFeedback? @relation("FeedbackReportTask")

  @@index([status])
  @@index([type, status])
  @@index([countryId, status])
  @@index([assigneeId, status])
  @@index([objectType, objectId, status])
}

// ---------- P3-S1: Exams & versions (Master Plan §6 Exam/ExamVersion rows, §8, §11, §14, §36) ----------

// Exam lifecycle. An exam is a configuration object, not content: it does not
// ride the §19 content review workflow — Country Admins provision it (§18
// "Country Admin — country-specific content, exams…") and it becomes publicly
// listed when ACTIVE. RETIRED is end-of-life (§36 migration-safe — no hard
// deletes anywhere in the platform).
enum ExamStatus {
  DRAFT // configured, not yet public
  ACTIVE // publicly listed exam (§38 public app)
  INACTIVE // temporarily suspended/hidden, restorable
  RETIRED // end-of-life, read-only (history preserved)
}

// §6 Exam row "level" — the exam's administrative tier within its country.
enum ExamLevel {
  NATIONAL // country-wide conducting body (UPSC CSE, SSC CGL)
  STATE // state PSC / state recruitment boards
  REGIONAL // regional/district-level recruitment
}

// §6 Exam row: "Country-specific exam definition — id, country_id, name, code,
// organiser, level, status". Every exam belongs to EXACTLY ONE country (§14)
// and reaches knowledge ONLY through SyllabusNode → ExamMapping (P3-S2/S3 —
// §13 "exam names never enter the canonical taxonomy"). slug and code are
// immutable identity after create (§16 URL-stable, §37 stable identifiers).
model Exam {
  id          String     @id @default(cuid())
  slug        String     @unique // immutable, URL-stable (§16 /exams/{exam-slug}/)
  code        String // short human code, e.g. "UPSC-CSE" — unique per country, immutable
  name        String // canonical display name
  organiser   String // §6 conducting body, e.g. "Union Public Service Commission"
  level       ExamLevel  @default(NATIONAL)
  status      ExamStatus @default(DRAFT)
  countryId   String // §14 — never null: an exam without a country cannot exist
  description String? // public-facing summary (what the exam is, who runs it)
  notes       String? // internal editorial notes
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  country   Country        @relation("ExamCountry", fields: [countryId], references: [id])
  createdBy User?          @relation("ExamAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  versions  ExamVersion[]
  goalExams UserGoalExam[] // P5-S3 — declared goal exam references

  @@unique([countryId, code])
  @@index([status])
  @@index([countryId, status])
  @@index([level])
}

// ---------- P3-S3: ExamMapping (Master Plan §6, §8, §11, §12, §36) ----------

// §8 requirement-layer vocabulary. `relevance` answers §8's "Whether the
// knowledge unit is relevant to this exam/syllabus node" as the NATURE of the
// fit (how squarely the unit sits inside the node's scope), kept deliberately
// distinct from `priority` (study importance) — two different axes:
// DIRECT = squarely within the node's scope; PARTIAL = only part of the unit
// falls inside (expectedScope describes which part); CONTEXTUAL = background
// context the node's questions may assume, not ask directly.
enum MappingRelevance {
  DIRECT
  PARTIAL
  CONTEXTUAL
}

// §8 priority: "Importance such as core/supporting/low priority; avoid
// simplistic universal scoring" — an ordinal editorial judgement that feeds
// §11 step 7 ranking, never a numeric score.
enum MappingPriority {
  CORE
  SUPPORTING
  LOW
}

// §8 required_depth: "one-line, fact, concept, detailed, analytical, etc." —
// the depth of understanding THIS exam demands of the SAME canonical unit.
// The §11 engine unions mappings by taking the MAXIMUM across followed exams
// (Appendix A: Exam A ONE_LINE + Exam B ANALYTICAL → render the deep view once).
enum RequiredDepth {
  ONE_LINE
  FACT
  CONCEPT
  DETAILED
  ANALYTICAL
}

// §8 question_likelihood: "Editorial/analytical metadata; not a guaranteed
// prediction" — surfaces on coverage views with exactly that disclaimer.
enum QuestionLikelihood {
  HIGH
  MEDIUM
  LOW
}

// §6 ExamMapping row: "Knowledge-to-exam relationship — knowledge_unit_id,
// exam_version_id, syllabus_node_id, relevance, priority, required_depth,
// expected_scope, question_likelihood, source_basis, effective_period, notes".
// This is §8's requirement layer: the SAME canonical KnowledgeUnit maps to
// many exams at different depths — never copied content (§46.2 "Exam mapping
// is a relationship, not copied content").
//
// ANCHORS: a mapping is pinned to exactly one SyllabusNode (which pins it to
// the node's ExamVersion) and one KnowledgeUnit. The triple is §11 step 3's
// expansion input ("Expand each ExamVersion's SyllabusNode tree into its
// mapped canonical KnowledgeUnits via ExamMapping") and §13's only
// exam→knowledge path.
//
// §36 EDITABILITY (mapping-specific, and deliberately different from the
// tree rule): the SyllabusNode TREE freezes the moment its version starts,
// but MAPPINGS keep flowing on the CURRENT version — §12 step 5 requires "a
// current-affairs item [to] flow directly into a followed exam's combined
// queue the moment it's mapped", which is only possible if mappings may be
// added to an in-effect version (events occur mid-window). Therefore:
//   staged = DRAFT exam or future-dated version (tree + mappings editable);
//   live   = the CURRENT version in effect — mappings editable (audited),
//            tree still frozen (P3-S2 rule unchanged);
//   frozen = a version that started but is no longer current (superseded) —
//            its mappings are §36 history, "old mappings remain historically
//            queryable", and never mutate again;
//   locked = RETIRED exam.
// `effectiveFrom/effectiveTo` (§8 "effective_period — when the mapping is
// valid") bound a mapping's validity INSIDE the version's life at day
// granularity (e.g. a current-affairs mapping relevant until the next exam
// cycle); null = valid for the whole version window.
model ExamMapping {
  id                 String             @id @default(cuid())
  knowledgeUnitId    String // §7 canonical record — one unit, many mappings
  examVersionId      String // pinned via the node's version (§36 anchor)
  syllabusNodeId     String // §6/§13 anchor — the node the unit attaches to
  relevance          MappingRelevance   @default(DIRECT)
  priority           MappingPriority    @default(SUPPORTING)
  requiredDepth      RequiredDepth      @default(CONCEPT)
  questionLikelihood QuestionLikelihood @default(MEDIUM)
  expectedScope      String? // §8 "what portion/aspect is actually relevant"
  sourceBasis        String? // §8 "why the mapping exists" (notification §, PYQs, editor)
  effectiveFrom      DateTime? // §8 effective_period start (inclusive; null = version start)
  effectiveTo        DateTime? // §8 effective_period end (inclusive last day; null = no end)
  notes              String? // §8 "human editorial explanation"
  createdById        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  knowledgeUnit KnowledgeUnit @relation("ExamMappingUnit", fields: [knowledgeUnitId], references: [id], onDelete: Cascade)
  examVersion   ExamVersion   @relation("ExamMappingVersion", fields: [examVersionId], references: [id], onDelete: Cascade)
  syllabusNode  SyllabusNode  @relation("ExamMappingNode", fields: [syllabusNodeId], references: [id], onDelete: Cascade)
  createdBy     User?         @relation("ExamMappingAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  // One mapping per unit per node (the node implies the version — a unit may
  // still map to several nodes of the same version, e.g. Prelims polity and
  // Mains Fundamental Rights).
  @@unique([knowledgeUnitId, syllabusNodeId])
  @@index([examVersionId])
  @@index([syllabusNodeId])
  @@index([knowledgeUnitId])
  @@index([knowledgeUnitId, requiredDepth])
}

// §6 ExamVersion row: "Versioned exam structure — id, exam_id, effective_from,
// effective_to, source". §36: "Exam syllabus changes create a new ExamVersion.
// Old mappings remain historically queryable." Windows are day-granular and
// NON-OVERLAPPING: the CURRENT version is the one whose [effectiveFrom,
// effectiveTo] window contains now (effectiveTo null = in effect until
// superseded). Creating a version closes the open predecessor at
// (newFrom − 1 day); windows are IMMUTABLE afterwards — history is append-only
// (§36). This model is the anchor for SyllabusNode (P3-S2) and ExamMapping
// (P3-S3), and the resolution point for the §11 combination engine's step 2
// ("Resolve each exam to its active ExamVersion").
model ExamVersion {
  id            String    @id @default(cuid())
  examId        String
  label         String // human label, e.g. "2025 syllabus (2025 notification)"
  effectiveFrom DateTime // inclusive first day (UTC midnight)
  effectiveTo   DateTime? // inclusive last day; null = in effect until superseded
  source        String? // §6 "source" — official notification/URL the structure came from
  notes         String? // internal editorial notes
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  exam          Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  createdBy     User?          @relation("ExamVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  syllabusNodes SyllabusNode[]
  examMappings  ExamMapping[]  @relation("ExamMappingVersion") // P3-S3
  questions     Question[]     @relation("QuestionExamVersion") // P7-S2: Questions authored for this version (§6 optional anchor)
  mockTests     MockTest[]     @relation("MockTestExamVersion") // P7-S3: EXAM-scoped mock tests (§6 exam_version_id)

  @@index([examId, effectiveFrom])
}

// §6 SyllabusNode row: "Exam syllabus tree — id, exam_version_id, parent_id,
// topic_id, depth, priority, notes". Nodes are pinned to exactly ONE
// ExamVersion (§36: a syllabus change creates a NEW version — once a version's
// window has started, its tree is history and never mutates; staging happens
// on future-dated versions or DRAFT exams). `name` is the exam's own syllabus
// label as printed in the official notification (§13: exam wording never
// enters the canonical taxonomy); `topicId` is the OPTIONAL link to the
// canonical Topic — the ONLY bridge between exam requirements and knowledge
// (§13: exams reach knowledge exclusively through SyllabusNode →
// ExamMapping, which lands in P3-S3 and anchors on these rows).
model SyllabusNode {
  id            String   @id @default(cuid())
  examVersionId String
  parentId      String? // null = root; must belong to the SAME exam version
  name          String // exam-syllabus label (notification wording — never taxonomy, §13)
  topicId       String? // canonical taxonomy link (GLOBAL or the exam's country — §13/§14)
  depth         Int // 0 for roots; parent.depth + 1 (denormalised for reads)
  priority      Int      @default(0) // sibling ordering (§6) — ascending within a parent
  notes         String? // internal editorial notes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  examVersion  ExamVersion    @relation(fields: [examVersionId], references: [id], onDelete: Cascade)
  parent       SyllabusNode?  @relation("SyllabusTree", fields: [parentId], references: [id])
  children     SyllabusNode[] @relation("SyllabusTree")
  topic        Topic?         @relation("SyllabusNodeTopic", fields: [topicId], references: [id])
  examMappings ExamMapping[]  @relation("ExamMappingNode") // P3-S3

  @@index([examVersionId, parentId, priority])
  @@index([topicId])
}

// ---------- P4-S1: Search (Master Plan §6, §17, §29, §43) ----------

// §17: "Search is a first-class product, not merely database text search" —
// this table is the platform's OWN vendor-neutral index format (§29 "the
// domain model must not depend on a specific search vendor"): the indexing
// pipeline projects published canonical objects into these documents, and the
// query engine reads them. Swapping in a managed search service later means
// re-pointing the engine adapter — never touching KnowledgeUnit/Exam/Topic.
//
// Granularity: one document per PUBLIC OBJECT × INDEXED LANGUAGE VARIANT
// (§7/§35 — representations are per-language; only languages that actually
// carry a published surface are indexed, never planned ones). §17 canonical-
// object deduplication is enforced at query time on (objectType, ref): the
// same unit's English and Hindi documents never both appear in one result
// list — the reader-language document wins, other-language documents are
// matched only through `neutralText` and presented as a canonical fallback.
enum SearchObjectType {
  KNOWLEDGE_UNIT // §7 canonical record — its public surface is the §22 page
  EXAM // §6 country exam — public surface is the §22 exam overview
  TOPIC // §13 canonical taxonomy node — public surface is the /gk/{topic}/ hub
  CURRENT_EVENT // §12 event-centric record (P6-S2) — public surface is the
  // /current-affairs/{slug}/ page; indexed once per language that carries a
  // PUBLISHED event representation, with §17.7 freshness = the event's own
  // eventDate (current affairs are fresh by when they HAPPENED, not by when
  // a correction landed)
}

model SearchDocument {
  id            String           @id @default(cuid())
  objectType    SearchObjectType
  ref           String // public slug of the object (unit/exam/topic slug — §37 stable identifier)
  languageCode  String // ISO code of the indexed language variant ('en', 'hi', …)
  // §14/§15 country scope, denormalised for server-side filtering: null =
  // GLOBAL (visible in every ACTIVE country); a code = that market only.
  countryIso    String?
  title         String // display title in the indexed language
  canonicalName String // English-reference canonical name (canonical-fallback presentation, §7)
  summary       String? // quick fact / description in the indexed language
  // Localised searchable text: representation titles + bodies + summary.
  // Tokenised INTO tsvLang at index time with the language's FTS config
  // (§17 "language-aware tokenisation" — 'english'/'hindi', verified live).
  bodyText      String
  // Language-neutral searchable text: canonical name + aliases + slug — the
  // cross-language surface (§17 aliases; a Hindi-context query finds an
  // English-only unit by canonical name and gets a canonical-fallback result).
  neutralText   String
  aliases       Json? // string[] — editorial aliases (§13 TopicAlias, exam codes) for exact/prefix tiers
  topicSlug     String? // units: the §13 primary topic slug; topics: the node's own slug
  topicLabel    String? // §35 topic label in the indexed language
  unitType      String? // units only: KnowledgeUnitType
  difficulty    String? // units only: KnowledgeDifficulty
  // string[] of exam slugs whose CURRENT §36 version carries an in-effect §8
  // mapping to this unit (any country — reader-country scoping happens at
  // query time, §14: a GB exam's requirement never leaks into an IN reader).
  examRefs      Json?
  freshnessAt   DateTime // ranking input (§17 freshness boosting; CurrentEvent lands P6)
  indexedAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Index-time tokenisation (§17): the pipeline writes these via raw SQL
  // (to_tsvector(<language config>, bodyText) / to_tsvector('simple', neutralText)).
  // GIN indexes are created idempotently by the engine's readiness step.
  tsvLang    Unsupported("tsvector")?
  tsvNeutral Unsupported("tsvector")?

  @@unique([objectType, ref, languageCode])
  @@index([languageCode])
  @@index([objectType, ref])
  @@index([countryIso])
  @@index([freshnessAt])
}

// ---------- P1-S1: Country & Language configuration (Master Plan §6, §14, §35) ----------

// Language is a first-class localisation dimension. `code` is the URL segment
// used for non-default languages (e.g. /hi/). Translations reference canonical
// content — language never duplicates knowledge identity (§35).
model Language {
  id         String            @id @default(cuid())
  code       String            @unique // e.g. "en", "hi", "cy"
  name       String // English reference name, e.g. "Hindi"
  nativeName String? // endonym, e.g. "हिन्दी"
  direction  LanguageDirection @default(LTR)
  status     LanguageStatus    @default(ACTIVE)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  // Countries where this language is the default (URL omits the segment)
  defaultForCountries Country[]         @relation("CountryDefaultLanguage")
  // Join to countries that support this language
  countryLinks        CountryLanguage[]
  users               User[]
  languageScopedUsers User[]            @relation("UserLanguageScope")
  topicLabels         TopicLabel[]
  topicAliases        TopicAlias[]
  contentItems        ContentItem[]
  qnas                QnA[]             @relation("QnALanguage") // P7-S1: Q&A learning representations
  questions           Question[]        @relation("QuestionLanguage") // P7-S2: scored assessment representations
  mockTests           MockTest[]        @relation("MockTestLanguage") // P7-S3: timed, scoped assemblies of Questions
  editorialTasks      EditorialTask[]
  goalStudyLanguages  UserGoal[]        @relation("UserGoalStudyLanguage") // P5-S3
  entityAliases       EntityAlias[] // P6-S3: language-specific alias spellings

  @@index([status])
}

// Country is a first-class scope enforced server-side (§14, §15).
// India is the default root market (isDefault = true): its slug never
// appears in URLs. Other countries live under /{country.slug}/ (§16).
model Country {
  id                String        @id @default(cuid())
  isoCode           String        @unique // ISO 3166-1 alpha-2, e.g. "IN", "GB"
  slug              String        @unique // URL segment for non-default countries, e.g. "uk"
  name              String
  timezone          String? // IANA timezone, e.g. "Asia/Kolkata"
  status            CountryStatus @default(ACTIVE)
  isDefault         Boolean       @default(false) // exactly one root market (India)
  defaultLanguageId String? // primary language; omitted from URLs (§35)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  defaultLanguage Language?         @relation("CountryDefaultLanguage", fields: [defaultLanguageId], references: [id])
  supported       CountryLanguage[] // languages configured for this country only (§35)
  users           User[]
  topics          Topic[] // country-scoped taxonomy extension nodes (§13)
  knowledgeUnits  KnowledgeUnit[]   @relation("KnowledgeUnitCountry")
  editorialTasks  EditorialTask[]
  exams           Exam[]            @relation("ExamCountry") // P3-S1: every exam belongs to exactly one country (§14)
  currentEvents   CurrentEvent[]    @relation("CurrentEventCountry") // P6-S1: §14 country-scoped events
  entities        Entity[] // P6-S3: §14 country-scoped entity reference records

  @@index([status])
}

// Explicit join table (no scalar lists): the set of languages a country
// actually exposes — never a global language list (§35).
model CountryLanguage {
  id         String   @id @default(cuid())
  countryId  String
  languageId String
  createdAt  DateTime @default(now())

  country  Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([countryId, languageId])
  @@index([languageId])
}

// ---------- P1-S2: Identity & Access (Master Plan §6, §20, §30, §39, §43) ----------

// Base user + auth fields (roles, status, auth method) + the §6 personalisation
// dimensions (home country, preferred language, onboarding state, §20 staff
// language scope, and the one declared UserGoal — P5-S3).
model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  name                String?
  homeCountryId       String?
  preferredLanguageId String?
  // P2-S4 (§18/§20): explicit staff language scope — when set on a WRITER,
  // content/task operations narrow to this language (a Hindi-scoped writer
  // cannot touch English representations). Null = all languages within the
  // country scope. Set via seed/staff provisioning; self-registration never
  // sets it (READER accounts carry no editorial scope).
  languageScopeId     String?
  // Auth (P1-S2): token-based identity — the same Bearer-token contract serves
  // the website today and native apps later (§4, §39).
  passwordHash        String? // null reserved for future non-password auth methods
  role                UserRole   @default(READER)
  status              UserStatus @default(ACTIVE)
  authMethod          AuthMethod @default(PASSWORD)
  emailVerifiedAt     DateTime? // verification flow itself is a later concern
  lastLoginAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  homeCountry                Country?           @relation(fields: [homeCountryId], references: [id])
  preferredLanguage          Language?          @relation(fields: [preferredLanguageId], references: [id])
  languageScope              Language?          @relation("UserLanguageScope", fields: [languageScopeId], references: [id])
  authSessions               AuthSession[]
  auditLogs                  AuditLog[]
  authoredKnowledgeUnits     KnowledgeUnit[]    @relation("KnowledgeUnitAuthor")
  authoredContentItems       ContentItem[]      @relation("ContentItemAuthor")
  publishedContentRevisions  ContentRevision[]  @relation("ContentRevisionPublisher")
  createdSources             Source[]           @relation("SourceAuthor")
  assignedEditorialTasks     EditorialTask[]    @relation("EditorialTaskAssignee")
  createdEditorialTasks      EditorialTask[]    @relation("EditorialTaskCreator")
  resolvedEditorialTasks     EditorialTask[]    @relation("EditorialTaskResolver")
  createdExams               Exam[]             @relation("ExamAuthor") // P3-S1
  createdExamVersions        ExamVersion[]      @relation("ExamVersionAuthor") // P3-S1
  createdExamMappings        ExamMapping[]      @relation("ExamMappingAuthor") // P3-S3
  follows                    UserFollow[] // P5-S1
  saves                      SavedItem[] // P5-S2
  collections                Collection[] // P5-S2
  // P5-S3 (§6): onboarding state + the one declared goal (§9 explicit signal).
  onboardingStatus           OnboardingStatus   @default(PENDING)
  onboardingCompletedAt      DateTime?
  goal                       UserGoal?
  // P6-S1 (§12): canonical current-event records authored by this user.
  createdCurrentEvents       CurrentEvent[]     @relation("CurrentEventAuthor")
  // P7-S1 (§22/§23): QnA entries authored + revisions published by this user.
  authoredQnas               QnA[]              @relation("QnAAuthor")
  publishedQnaRevisions      QnARevision[]      @relation("QnARevisionPublisher")
  // P7-S2 (§22/§23): Questions authored + revisions published by this user.
  authoredQuestions          Question[]         @relation("QuestionAuthor")
  publishedQuestionRevisions QuestionRevision[] @relation("QuestionRevisionPublisher")
  // P7-S3 (§22/§23): MockTests authored + revisions published + attempts made.
  authoredMockTests          MockTest[]         @relation("MockTestAuthor")
  publishedMockTestRevisions MockTestRevision[] @relation("MockTestRevisionPublisher")
  testAttempts               TestAttempt[]      @relation("UserAttempts")
  // P7-S4 (§6/§22): derived per-unit mastery states (the revision queue's store).
  masteryStates              MasteryState[]     @relation("UserMastery")
  // P8-S1 (§21/§32): share events attributed to this user (anonymous shares
  // carry userId null — §21 "track share events as analytics events").
  shareEvents                ShareEvent[]       @relation("UserShareEvents")
  // P8-S2 (§27): queued/sent/read notifications + per-category opt-ins.
  notifications              NotificationEvent[]       @relation("UserNotifications")
  notificationPreferences    NotificationPreference[]  @relation("UserNotificationPreferences")
  // P8-S3 (§25): reports filed by this user (anonymous reports have no row
  // here) + reports this user resolved as an editor.
  contentFeedbacks           ContentFeedback[]  @relation("UserContentFeedback")
  resolvedContentFeedbacks   ContentFeedback[]  @relation("UserResolvedContentFeedback")

  @@index([homeCountryId])
  @@index([preferredLanguageId])
  @@index([languageScopeId])
  @@index([status])
}

// One row per issued Bearer token (a logged-in device/app). Only the SHA-256
// hash of the token is stored — the raw token exists solely in the client's
// hands. Sessions are listable and revocable (logout = revoke current session;
// "sign out everywhere" = revoke all — §30 security posture).
model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  label      String? // client-provided device/app label, e.g. "Web — Chrome"
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime? // null = active

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------- P1-S4: Taxonomy (Master Plan §6 Topic model, §13, §36) ----------

// Canonical taxonomy node — the single global framework with country-specific
// extensions (§13). `slug` is immutable after creation so URLs stay stable
// (§16/§36); renames only touch canonicalName/labels. Deletion is always soft
// (RETIRED) — taxonomy changes must be migration-safe (§36).
model Topic {
  id            String        @id @default(cuid())
  slug          String        @unique // immutable, URL-stable, kebab-case
  canonicalName String
  description   String? // canonical (English-reference) description
  type          TopicNodeType
  status        TopicStatus   @default(ACTIVE)
  scope         TopicScope    @default(GLOBAL)
  countryId     String? // set iff scope = COUNTRY (explicit, never inferred — §14)
  parentId      String?
  orderIndex    Int           @default(0) // stable sibling ordering
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  parent         Topic?              @relation("TopicTree", fields: [parentId], references: [id])
  children       Topic[]             @relation("TopicTree")
  country        Country?            @relation(fields: [countryId], references: [id])
  labels         TopicLabel[]
  aliases        TopicAlias[]
  knowledgeUnits KnowledgeUnit[]     @relation("KnowledgeUnitTopic")
  syllabusNodes  SyllabusNode[]      @relation("SyllabusNodeTopic")
  goalTopics     UserGoalTopic[] // P5-S3 — declared goal subject references
  currentEvents  CurrentEvent[]      @relation("CurrentEventTopic") // P6-S1: §12 step 3 primary topic
  eventFilings   CurrentEventTopic[] // P6-S3: additional cross-filing links
  mockTests      MockTest[]          @relation("MockTestTopic") // P7-S3: TOPIC-scoped mock tests (§6 scope)

  @@index([parentId, orderIndex])
  @@index([status])
  @@index([scope, countryId])
}

// Localised name/description per language (§13 "language labels"). The
// canonical record stays single — labels are rendering dimensions (§35).
model TopicLabel {
  id          String   @id @default(cuid())
  topicId     String
  languageId  String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topic    Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id])

  @@unique([topicId, languageId])
  @@index([languageId])
}

// Alternate search terms (§13 "aliases") — e.g. "FR" → Fundamental Rights.
// languageId null = language-neutral alias.
model TopicAlias {
  id         String   @id @default(cuid())
  topicId    String
  value      String
  languageId String?
  createdAt  DateTime @default(now())

  topic    Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  language Language? @relation(fields: [languageId], references: [id])

  @@unique([topicId, value])
  @@index([languageId])
}

// ---------- P1-S5: Audit (Master Plan §6 AuditLog model, §19, §30, §36, §204-row) ----------

// Append-only accountability trail: actor, action, object, timestamp,
// before/after (§6). Rows are NEVER updated or deleted — corrections are new
// events. Sensitive values (password/token hashes) are redacted before write
// by the audit module (§30 data minimisation). Actor identity is denormalised
// (email/role at action time) so the trail stays readable even after the user
// row is deleted (actorId → SetNull).
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String? // null = system / deleted user / anonymous attempt
  actorEmail  String? // denormalised snapshot (accountability after deletion)
  actorRole   String? // role held at action time
  action      String // namespaced event key, e.g. "taxonomy.topic.update"
  objectType  String // "Topic" | "Country" | "Language" | "AuthSession" | "User" | …
  objectId    String?
  objectLabel String? // human-readable identity (slug/code/email) for reads
  before      Json? // state prior to the mutation (redacted)
  after       Json? // state after the mutation (redacted)
  metadata    Json? // request context: ip, userAgent, scope, reason, …
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([objectType, objectId])
  @@index([action, createdAt])
}

// ---------- P5-S1: UserFollow (Master Plan §6 UserFollow row, §9, §10, §11, §14) ----------

// A user's declared ongoing interest in a followable object (EXAM | TOPIC
// today; ENTITY/THEME join in P6). Follow is a *personalisation signal* —
// feed, notifications, recommendations and dashboard context (§10) — and is
// deliberately separate from SavedItem/collections (P5-S2: retrieval, never
// a recommendation input).
//
// §14: user-personalised data stays strictly scoped to the owning country —
// an exam/topic may only be followed from the user's home market (enforced
// in the follow-save service, never by UI hiding). GLOBAL topics are
// followable from any market.
//
// The unique triple makes follow/unfollow idempotent at the storage layer;
// rows cascade with the user (§30/§31: deleting an account removes their
// personalisation data). Followed objects themselves are soft-deleted
// (RETIRED) elsewhere in the model, so a follow never dangles — the list
// resolves honestly with the object's current status (§36).
model UserFollow {
  id         String           @id @default(cuid())
  userId     String
  objectType FollowObjectType
  objectId   String // canonical id of the Exam/Topic row (never a slug)
  followedAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, objectType, objectId])
  @@index([userId, objectType])
  @@index([objectType, objectId])
}

// ---------- P5-S2: SavedItem + Collection (Master Plan §6 rows, §10, §31) ----------

// Savable object vocabulary (§10: "any eligible content/knowledge unit/QnA/
// Question/MockTest/current event"). QnA/Question/MockTest (P7) extend this
// enum additively — the P5-S1 FollowObjectType precedent. EXAM/TOPIC/ENTITY
// are deliberately NOT here: following is the §10 affordance for exams/topics/
// entities; saves are for content objects. CURRENT_EVENT joined in P6-S3.
enum SavedObjectType {
  KNOWLEDGE_UNIT // the canonical record (§7) — survives representation updates
  CONTENT_ITEM // a specific published language × format representation
  CURRENT_EVENT // P6-S3 (§10): the event record — its §16 page is the retrieval surface
  QNA // P7-S1 (§10/§22): a published Q&A learning entry — reopens the unit page's Q&A layer
  QUESTION // P7-S2 (§10/§22): a published MCQ practice question — reopens the unit page's practice layer
  MOCK_TEST // P7-S3 (§10/§22): a published mock test — reopens the test runner page
}

// §6 Collection row carries visibility. PRIVATE is the default (§10); LINK
// is the P8-S1 §21 sharing opt-in — the owner EXPLICITLY makes the
// collection shareable via its stable link ("eligible collection"). There
// is deliberately no PUBLIC value: a shared collection is unlisted
// (reachable only via the link, never listed/indexed), and the owner can
// revoke sharing anytime (§31 reversibility).
enum CollectionVisibility {
  PRIVATE
  LINK // §21: explicitly made shareable by the owner — unlisted link sharing
}

// A user-organised bucket of saved items (§10). The bootstrap "Saved"
// collection (isDefault, one per user, name fixed per §10) is created lazily
// by the service on the user's first save — never seeded. Custom collections
// are user-defined ("Revision", "Important Polity", …); names are unique per
// user. Deleting a non-default collection returns its items to the default
// (never destroys saves — §31 reversibility); the default itself is
// immutable. Rows cascade with the user (§30/§31).
model Collection {
  id         String               @id @default(cuid())
  userId     String
  name       String
  isDefault  Boolean              @default(false) // the §10 bootstrap collection
  visibility CollectionVisibility @default(PRIVATE)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items SavedItem[]

  @@unique([userId, name])
  @@index([userId])
}

// A user's saved (bookmarked) content object (§10). Save is an explicit
// RETRIEVAL action — never a recommendation/personalisation signal by
// itself; it is deliberately separate from UserFollow (P5-S1).
//
// The row stores the canonical object id (never a slug) and the §7 identity
// rule keeps it stable: publishing a new ContentRevision updates the item
// under the SAME row — "saved objects retain a stable reference to the
// canonical object so later updates do not create duplicates" (§10). One row
// per (user, object): re-organising is a MOVE between collections, never a
// copy. Retired/withdrawn objects never delete the row — the list resolves
// them to honest tombstones (§10/§36).
model SavedItem {
  id           String          @id @default(cuid())
  userId       String
  objectType   SavedObjectType
  objectId     String // canonical id of the KnowledgeUnit/ContentItem row
  collectionId String
  savedAt      DateTime        @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([userId, objectType, objectId])
  @@index([userId, objectType])
  @@index([collectionId])
  @@index([objectType, objectId])
}

// ---------- P5-S3: Onboarding state + explicit goals (Master Plan §6, §9, §31) ----------

// §6 User carries "onboarding state". PENDING at registration; the guided
// flow (or any goal mutation) moves it to IN_PROGRESS; the user completes or
// explicitly skips. SKIPPED is a deliberate end-state choice, never an error
// — the flow stays reachable from #/profile forever (§9: goals are
// changeable at any time). Both end states are idempotent to re-declare.
enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

// §6 UserGoal/Profile "level" — the self-declared preparation level that
// feeds §9 explicit personalisation (difficulty shaping in later sessions).
enum GoalLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// The §6 UserGoal/Profile row: "user_id, exam_ids, topics, level, language,
// preferences". One row per user (§9: a single coherent declared goal, not a
// stream of events — goals are REPLACED, never accumulated; §31: changeable
// and removable at any time).
//
// exam_ids/topics live in the UserGoalExam/UserGoalTopic join rows (a goal
// exam/topic is a relationship to the canonical Exam/Topic row, cascading
// with the goal — never a scalar list, so referential honesty is structural).
//
// §9 boundary: a declared goal is an EXPLICIT signal — like follows it drives
// personalisation only, never anything with legal/commercial consequence
// ("must not be treated as proof the user will actually sit the exam").
// §14: goal exams are strictly home-market; GLOBAL topics any market,
// COUNTRY topics home market only (enforced at mutation time; existing rows
// resolve honestly with §36 statuses if the market context later changes).
model UserGoal {
  id              String     @id @default(cuid())
  userId          String     @unique
  level           GoalLevel? // self-declared preparation level (§6)
  studyLanguageId String? // null = follow the account's preferred language (§35)
  targetYear      Int? // exam year the user is preparing for (e.g. 2026)
  dailyMinutes    Int? // §6 "preferences": self-declared daily study pace
  declaredAt      DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyLanguage Language?       @relation("UserGoalStudyLanguage", fields: [studyLanguageId], references: [id])
  exams         UserGoalExam[]
  topics        UserGoalTopic[]

  @@index([userId])
  @@index([studyLanguageId])
}

// One declared goal exam — a canonical Exam row reference (§14: home-market
// ACTIVE exams only at declare time; later lifecycle changes resolve
// honestly in the goal read, §36).
model UserGoalExam {
  id      String   @id @default(cuid())
  goalId  String
  examId  String
  addedAt DateTime @default(now())

  goal UserGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  exam Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([goalId, examId])
  @@index([goalId])
  @@index([examId])
}

// One declared goal subject/topic — a canonical Topic row reference
// (§13/§14: GLOBAL topics from any market, COUNTRY topics home market only).
model UserGoalTopic {
  id      String   @id @default(cuid())
  goalId  String
  topicId String
  addedAt DateTime @default(now())

  goal  UserGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  topic Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([goalId, topicId])
  @@index([goalId])
  @@index([topicId])
}

// ---------- P6-S1: Current Affairs — CurrentEvent + source aggregation
// (Master Plan §6 CurrentEvent row, §12 Current Affairs Architecture, §14, §16,
// §24, §36, §45) ----------

// §12 step 6 lifecycle states: emerging → developing → stable → archived.
// EMERGING   — breaking/tracked; sources being aggregated; the editorial
//              "create the event before five publishers become five objects"
//              state (§12).
// DEVELOPING — more sources/context accumulating; corrections expected.
// STABLE     — the established canonical understanding of the event.
// ARCHIVED   — end-of-life; read-only like RETIRED taxonomy/content (§36) —
//              reopenable via an explicit transition, never edited in place.
// P6-S5 adds automated freshness→archive rules on top of this manual machine.
enum CurrentEventLifecycle {
  EMERGING
  DEVELOPING
  STABLE
  ARCHIVED
}

// §6 CurrentEvent row: "id, event_date, location, entities, summary,
// significance, lifecycle_state". Event-centric, NOT article-centric (§12):
// one real-world event = one row, whatever the number of publishers covering
// it. Fields are the canonical English-reference record — language
// representations are the P6-S2 publishing layer, exactly as ContentItems
// represent KnowledgeUnits (§7). `entities` land with the Entity model in
// P6-S3 (the documented extension point — never a JSON placeholder).
//
// Country scope is explicit (§14): GLOBAL events are world-relevant
// (ADMIN-managed like all global objects); COUNTRY events belong to exactly
// one market. The primary §13 topic is required — the Current Affairs domain
// nodes plus every other taxonomy branch are valid anchors; P6-S3 adds the
// richer entity/multi-topic linking. `slug` is immutable and URL-stable for
// the §16 canonical `/current-affairs/{slug}/` page (rendered from P6-S2).
model CurrentEvent {
  id             String                @id @default(cuid())
  slug           String                @unique // immutable, URL-stable (§16)
  title          String // canonical (English-reference) event title
  eventDate      DateTime // §6 event_date — when the event happened
  eventEndDate   DateTime? // optional span end (multi-day summits, sessions)
  location       String? // §6 location — free-text place, e.g. "Sriharikota, Andhra Pradesh"
  summary        String // §6 summary — what happened (canonical reference)
  significance   String? // §6 significance — why it matters for GK/exams
  lifecycleState CurrentEventLifecycle @default(EMERGING)
  scope          TopicScope            @default(GLOBAL) // §14 GLOBAL/COUNTRY
  countryId      String? // set iff scope = COUNTRY (explicit, never inferred)
  topicId        String // §13 primary canonical topic
  notes          String? // internal editorial notes
  createdById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  country          Country?                    @relation("CurrentEventCountry", fields: [countryId], references: [id])
  topic            Topic                       @relation("CurrentEventTopic", fields: [topicId], references: [id])
  createdBy        User?                       @relation("CurrentEventAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  sources          CurrentEventSource[]
  knowledgeUnits   CurrentEventKnowledgeUnit[]
  // P6-S3 (§12 step 3): the entity + additional-topic linking layer.
  entities         CurrentEventEntity[]
  additionalTopics CurrentEventTopic[]
  // §12 step 4 (P6-S2): the event's language-specific representations —
  // ContentItems anchored here, riding the §19 workflow + §36 revisions.
  representations  ContentItem[]               @relation("ContentItemEvent")

  @@index([lifecycleState])
  @@index([lifecycleState, eventDate])
  @@index([scope, countryId])
  @@index([topicId])
  @@index([eventDate])
}

// §12 step 2: attach one or more Source records to the event — the SOURCE
// AGGREGATION join. Reuses the platform-level shared Source registry (P2-S3):
// the same URL is one Source row whether it backs a ContentItem or an event
// (the §11 dedup philosophy applied to evidence), so attaching an
// already-registered URL reuses the record and its verification state.
// `isPrimary` marks the lead evidence (at most one per event — swapped by the
// service); `note` carries event-level attribution ("what this source adds").
// Links are live provenance metadata: every attach/update/detach is audited
// and detach removes the link row only — the Source record and its other
// links are preserved (§36).
model CurrentEventSource {
  id             String   @id @default(cuid())
  currentEventId String
  sourceId       String
  isPrimary      Boolean  @default(false) // the lead source (one per event)
  note           String? // event-level attribution: what this source adds
  createdAt      DateTime @default(now())

  currentEvent CurrentEvent @relation(fields: [currentEventId], references: [id], onDelete: Cascade)
  source       Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([currentEventId, sourceId])
  @@index([sourceId])
}

// §12 step 3: attach the relevant canonical KnowledgeUnits to the event —
// the §7 one-truth rule for current affairs. A breaking event points at the
// established knowledge it touches (the Chandrayaan-3 event → the
// Chandrayaan-3 unit) instead of re-entering facts; the exam layer keeps
// flowing through the SAME unit (§8). Only VERIFIED units are linkable —
// DRAFT/IN_REVIEW knowledge is not yet canonical truth (P2-S1 public
// visibility rule). P6-S2 representations hang off the event separately.
model CurrentEventKnowledgeUnit {
  id              String   @id @default(cuid())
  currentEventId  String
  knowledgeUnitId String
  note            String? // why this unit is relevant to the event
  createdAt       DateTime @default(now())

  currentEvent  CurrentEvent  @relation(fields: [currentEventId], references: [id], onDelete: Cascade)
  knowledgeUnit KnowledgeUnit @relation(fields: [knowledgeUnitId], references: [id], onDelete: Cascade)

  @@unique([currentEventId, knowledgeUnitId])
  @@index([knowledgeUnitId])
}

// ---------- P6-S3: Entity registry + event linking (Master Plan §6 Entity row,
// §12 step 3, §13, §14, §17, §36, §45) ----------

// §6 Entity row: "Person/place/org/concept etc. — id, type, canonical name,
// aliases, country". Entities are canonical REFERENCE records (like Topics and
// the §24 Source registry — never content): one row per real-world entity,
// whatever the number of events that mention it. `slug` is immutable,
// kebab-case, URL-stable identity (the §16/§36 precedent — public entity
// pages may come later; the slug is reserved now).
//
// §14 scoping follows the Topic precedent exactly: GLOBAL entities
// (countryId null) are world-reference records, ADMIN-managed like all global
// objects; COUNTRY entities belong to exactly one market (managed by that
// market's admin, followable only from there). Linking is NOT scope-checked:
// an event may reference any ACTIVE entity (a GLOBAL event links the ISRO
// entity; a COUNTRY/IN event links the UN) — links are editorial metadata
// governed by the EVENT's manage permission, the §24 shared-registry
// philosophy applied to reference data.
enum EntityType {
  PERSON
  PLACE
  ORGANISATION
  CONCEPT // missions, schemes, treaties, awards, events-as-subjects, …
}

// §36: soft-delete only — RETIRED entities stop new links/follows; existing
// links/follows stay as honest history (never a cascade surprise).
enum EntityStatus {
  ACTIVE
  RETIRED
}

model Entity {
  id            String       @id @default(cuid())
  slug          String       @unique // immutable, kebab-case (§16/§36)
  canonicalName String
  description   String? // canonical (English-reference) one-liner
  type          EntityType
  status        EntityStatus @default(ACTIVE)
  scope         TopicScope   @default(GLOBAL) // §14 GLOBAL/COUNTRY (Topic precedent)
  countryId     String? // set iff scope = COUNTRY (explicit, never inferred)
  notes         String? // internal editorial notes
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  country Country?             @relation(fields: [countryId], references: [id])
  aliases EntityAlias[]
  events  CurrentEventEntity[]

  @@index([type, status])
  @@index([scope, countryId])
  @@index([status])
}

// Alternate names/spellings (§6 "aliases", the TopicAlias §13 precedent):
// "ISRO" → Indian Space Research Organisation; "UNSC" → United Nations
// Security Council. languageId null = language-neutral alias. Aliases feed
// §17 search matching (entity names are first-class search terms) without
// touching the canonical name.
model EntityAlias {
  id         String   @id @default(cuid())
  entityId   String
  value      String
  languageId String?
  createdAt  DateTime @default(now())

  entity   Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  language Language? @relation(fields: [languageId], references: [id])

  @@unique([entityId, value])
  @@index([languageId])
}

// §12 step 3: attach entities to the event — who/what the event is about.
// Mirrors CurrentEventKnowledgeUnit: live editorial metadata (every
// attach/detach audited), link rows only (the Entity record and its other
// links are preserved on detach, §36).
model CurrentEventEntity {
  id             String   @id @default(cuid())
  currentEventId String
  entityId       String
  note           String? // why this entity is relevant ("the landing agency")
  createdAt      DateTime @default(now())

  currentEvent CurrentEvent @relation(fields: [currentEventId], references: [id], onDelete: Cascade)
  entity       Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([currentEventId, entityId])
  @@index([entityId])
}

// §12 step 3 richer taxonomy: the event's ADDITIONAL canonical topics beyond
// the required primary (CurrentEvent.topicId). A story is often filed under
// several branches (Chandrayaan-3 → ISRO Programmes AND Space Technology);
// the primary stays the §13 breadcrumb anchor, these are the cross-filings.
// Scope rule mirrors the create-time invariant: a COUNTRY topic may only
// attach to a COUNTRY event of the same market (§13/§14 containment).
model CurrentEventTopic {
  id             String   @id @default(cuid())
  currentEventId String
  topicId        String
  note           String? // why this additional filing fits
  createdAt      DateTime @default(now())

  currentEvent CurrentEvent @relation(fields: [currentEventId], references: [id], onDelete: Cascade)
  topic        Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([currentEventId, topicId])
  @@index([topicId])
}

// ---------- P7-S1: QnA — explanatory question-and-answer content (Master Plan §6 QnA row, §7, §19, §22, §23, §36) ----------

// A QnA is a LEARNING representation (§23 "explanatory, unscored" — the v2.0
// correction that split it from the scored Question, P7-S2): one question and
// its explanatory prose answer, anchored to a canonical KnowledgeUnit (§7 —
// the fact is never re-entered, only rendered). It rides the same §19
// workflow and §36 revision discipline as ContentItem: questionText and
// answerBody are the WORKING COPY (editorial staging); public reads always
// serve the live QnARevision snapshot, so staged corrections stay invisible
// until a new revision publishes. Status reuses ContentStatus — the shared
// §19 state machine (DRAFT → IN_REVIEW → SCHEDULED/PUBLISHED → RETIRED).
//
// Identity (§11 canonical-identity rule applied to QnA): within one
// unit × language, the QUESTION TEXT identifies exactly one QnA — the same
// question twice is duplication, while many DIFFERENT questions about the
// same unit are the normal §22 knowledge-page Q&A layer.
model QnA {
  id                  String        @id @default(cuid())
  knowledgeUnitId     String // §7 anchor — QnA represents a canonical unit (never an event: §6 lists only knowledge_unit_id)
  languageId          String
  status              ContentStatus @default(DRAFT) // §19 workflow (shared states)
  questionText        String // working copy (current editing state)
  answerBody          String // working copy — public reads never touch this
  // §24/§26 AI-provenance flag (working copy): QnA is a named §26
  // AI-candidate format ("generate QnA candidates from an approved unit") —
  // snapshotted onto QnARevision at publish time.
  aiAssisted          Boolean       @default(false)
  publishedRevisionId String? // live revision pointer (null = never published)
  // §19 step 7: set by the `schedule` transition (IN_REVIEW → SCHEDULED);
  // due items materialize to PUBLISHED lazily on read (qna-service).
  scheduledForAt      DateTime?
  createdById         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  knowledgeUnit     KnowledgeUnit @relation("QnAUnit", fields: [knowledgeUnitId], references: [id])
  language          Language      @relation("QnALanguage", fields: [languageId], references: [id])
  createdBy         User?         @relation("QnAAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  revisions         QnARevision[] @relation("QnARevisions")
  publishedRevision QnARevision?  @relation("LiveQnARevision", fields: [publishedRevisionId], references: [id])

  @@unique([knowledgeUnitId, languageId, questionText])
  @@index([status])
  @@index([knowledgeUnitId, status])
  @@index([languageId, status])
}

// Immutable published snapshot (§36 "Published content revisions preserve
// previous versions") — the QnA twin of ContentRevision. Rows are NEVER
// updated or deleted; publishing again appends revision N+1 and moves the
// QnA's live pointer. Every correction carries a changeSummary (§25/§36
// provenance — never a silent edit).
model QnARevision {
  id             String   @id @default(cuid())
  qnaId          String
  revisionNumber Int // 1-based, deterministic within the QnA
  questionText   String // immutable snapshot at publish time
  answerBody     String // immutable snapshot at publish time
  changeSummary  String? // why this revision exists (required on re-publish)
  // §24/§26 AI-provenance snapshot at publish time — immutable like the rest.
  aiAssisted     Boolean  @default(false)
  publishedById  String?
  publishedAt    DateTime @default(now())

  qna         QnA   @relation("QnARevisions", fields: [qnaId], references: [id], onDelete: Cascade)
  publishedBy User? @relation("QnARevisionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  liveFor     QnA[] @relation("LiveQnARevision")

  @@unique([qnaId, revisionNumber])
  @@index([qnaId, publishedAt])
}

// ---------- P7-S2: Question — the scored assessment object (Master Plan §6 Question row, §22, §23, §43) ----------

// §23 content format "Question (scored, MCQ or other assessment type)" — the
// atomic assessment object, structurally distinct from QnA (§46.14: "QnA,
// Question, and MockTest are structurally distinct entities — never collapse
// them into one generic 'question' table"). A Question is one MCQ: options +
// a correct answer + an explanation, anchored to a canonical KnowledgeUnit
// (§7 — assessment REPRESENTS the record) and OPTIONALLY to the ExamVersion
// it was authored for (§6 exam_version_id — authoring context, never
// identity; scope/relevance routing is ExamMapping's job, §8). It rides the
// same §19 workflow as content and QnA, with the same §36 immutable-revision
// discipline. The correctAnswer NEVER ships to the public surface before an
// answer is checked — practice is scored server-side (§22 "scored
// assessment").
enum QuestionType {
  MCQ // single-correct multiple choice — the v1 launch format; §23 leaves room for other assessment types
}

model Question {
  id                  String              @id @default(cuid())
  knowledgeUnitId     String // §7 anchor — the canonical record this question assesses (§6 lists only knowledge_unit_id)
  examVersionId       String? // §6 OPTIONAL exam anchor — the version this was authored for (context, not identity; §8 routing is ExamMapping's job)
  languageId          String
  status              ContentStatus       @default(DRAFT) // §19 workflow (shared states)
  type                QuestionType        @default(MCQ)
  difficulty          KnowledgeDifficulty @default(BASIC) // §6 difficulty — the practice layer orders BASIC → ADVANCED
  questionText        String // working copy; §11 identity (create-time only, like QnA)
  optionsJson         String // JSON array [{key:'A',text:'…'},…] — §6 "options" (Prisma carries no list primitives; parsed/validated in the service)
  correctAnswer       String // the correct option KEY ('A'…) — working copy; never public pre-answer
  explanation         String // §6 explanation — teaching prose revealed after answering
  // §24/§26 AI-provenance flag (working copy) — snapshotted onto
  // QuestionRevision at publish time.
  aiAssisted          Boolean             @default(false)
  publishedRevisionId String? // live revision pointer (null = never published)
  // §19 step 7: set by the `schedule` transition; due items materialize to
  // PUBLISHED lazily on read (question-service).
  scheduledForAt      DateTime?
  createdById         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  knowledgeUnit     KnowledgeUnit      @relation("QuestionUnit", fields: [knowledgeUnitId], references: [id])
  examVersion       ExamVersion?       @relation("QuestionExamVersion", fields: [examVersionId], references: [id], onDelete: SetNull)
  language          Language           @relation("QuestionLanguage", fields: [languageId], references: [id])
  createdBy         User?              @relation("QuestionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  revisions         QuestionRevision[] @relation("QuestionRevisions")
  publishedRevision QuestionRevision?  @relation("LiveQuestionRevision", fields: [publishedRevisionId], references: [id])

  // §11 canonical identity: within one unit × language, the question text
  // identifies exactly one Question — the same discipline as QnA. The exam
  // anchor is NOT part of identity (the same MCQ serves any exam that maps
  // the unit).
  @@unique([knowledgeUnitId, languageId, questionText])
  @@index([status])
  @@index([knowledgeUnitId, status])
  @@index([languageId, status])
  @@index([examVersionId])
}

// Immutable published snapshot (§36) — the Question twin of QnARevision.
// Rows are NEVER updated or deleted; publishing again appends revision N+1
// and moves the live pointer. Every correction carries a changeSummary
// (§25/§36 provenance — never a silent edit).
model QuestionRevision {
  id             String   @id @default(cuid())
  questionId     String
  revisionNumber Int // 1-based, deterministic within the Question
  questionText   String // immutable snapshot at publish time
  optionsJson    String // immutable snapshot at publish time
  correctAnswer  String // immutable snapshot at publish time
  explanation    String // immutable snapshot at publish time
  difficulty     KnowledgeDifficulty @default(BASIC) // public-facing classification — snapshotted so staged difficulty edits never leak (§36)
  changeSummary  String? // why this revision exists (required on re-publish)
  // §24/§26 AI-provenance snapshot at publish time — immutable like the rest.
  aiAssisted     Boolean  @default(false)
  publishedById  String?
  publishedAt    DateTime @default(now())

  question    Question   @relation("QuestionRevisions", fields: [questionId], references: [id], onDelete: Cascade)
  publishedBy User?      @relation("QuestionRevisionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  liveFor     Question[] @relation("LiveQuestionRevision")

  @@unique([questionId, revisionNumber])
  @@index([questionId, publishedAt])
}

// ---------- P7-S3: MockTest + TestAttempt (Master Plan §6, §22, §43) ----------

// §6 MockTest: "A timed, scoped assembly of Questions" — id, title, scope
// (topic/exam/syllabus_node), question_ids[], duration_minutes,
// pass_criteria, exam_version_id (optional), status. Structurally distinct
// from Question (§46.14/§23: a Question is the atomic MCQ; a MockTest is the
// COMPOSED, timed, scoped product with its own §19 lifecycle). The §13 topic
// tree IS the syllabus tree, so a TOPIC scope covers topic AND syllabus_node
// scoping; an EXAM scope anchors to one ExamVersion (§6 exam_version_id).
enum MockTestScope {
  TOPIC // scoped to one §13 taxonomy node (a topic hub or an exam syllabus node — one tree)
  EXAM // scoped to one ExamVersion — "this exam's current syllabus"
}

// TestAttempt lifecycle: an attempt opens (IN_PROGRESS), submits within the
// deadline (SUBMITTED — then immutable: it is the §9/§22 mastery signal that
// feeds P7-S4), or lapses past its deadline without submission (ABANDONED).
enum TestAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  ABANDONED
}

model MockTest {
  id             String        @id @default(cuid())
  slug           String        @unique // §37 URL identity (…/mock-tests/{slug}/) — immutable, generated from the title
  title          String // working copy; §11 identity (create-time only — re-titling is a new test, the QnA/Question discipline)
  scopeType      MockTestScope
  topicId        String? // set iff scopeType = TOPIC (§6 "scope: topic/syllabus_node" — one §13 tree)
  examVersionId  String? // set iff scopeType = EXAM (§6 exam_version_id — the version whose syllabus the test covers)
  languageId     String // §35 — a test is a representation product like ContentItem/QnA/Question; every composed Question must match it
  status         ContentStatus @default(DRAFT) // §19 workflow (shared states)
  // §6 question_ids[] — the ordered composition (Prisma carries no list
  // primitives; parsed/validated in the service; snapshotted onto each
  // MockTestRevision at publish, §36).
  questionIdsJson String
  durationMinutes Int // §6 duration_minutes — the timed dimension
  passPercent     Int // §6 pass_criteria — the passing percentage (0–100)
  // §24/§26 AI-provenance flag (working copy) — an AI-suggested composition
  // freezes the flag onto each published revision.
  aiAssisted          Boolean @default(false)
  publishedRevisionId String? // live revision pointer (null = never published)
  // §19 step 7: set by the `schedule` transition; due items materialize to
  // PUBLISHED lazily on read (mocktest-service).
  scheduledForAt DateTime?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  topic             Topic?            @relation("MockTestTopic", fields: [topicId], references: [id], onDelete: SetNull)
  examVersion       ExamVersion?      @relation("MockTestExamVersion", fields: [examVersionId], references: [id], onDelete: SetNull)
  language          Language          @relation("MockTestLanguage", fields: [languageId], references: [id])
  createdBy         User?             @relation("MockTestAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  revisions         MockTestRevision[] @relation("MockTestRevisions")
  publishedRevision MockTestRevision? @relation("LiveMockTestRevision", fields: [publishedRevisionId], references: [id])
  attempts          TestAttempt[]      @relation("AttemptMockTest") // §6 TestAttempt rows — the §9/§22 mastery signal (P7-S4 consumes them)

  // §11 canonical identity: one title per scope × language. Topic and exam
  // references are deliberately NOT a DB unique (Postgres treats NULLs as
  // distinct, so a composite unique would not constrain EXAM-scoped rows);
  // the service enforces the identity with a friendly §37 error, and the
  // slug remains the hard URL identity.
  @@index([status])
  @@index([scopeType, topicId])
  @@index([scopeType, examVersionId])
  @@index([languageId, status])
}

// §36 immutable publish snapshot of a MockTest — the composition
// (question_ids[]), timing and pass criteria freeze here; public reads serve
// the live revision. Staged edits to the working copy never leak until a new
// revision publishes.
model MockTestRevision {
  id              String @id @default(cuid())
  mockTestId      String
  revisionNumber  Int // 1-based, deterministic within the MockTest
  title           String // immutable snapshot at publish time
  questionIdsJson String // §6 question_ids[] — the ordered composition snapshot
  durationMinutes Int // immutable snapshot at publish time
  passPercent     Int // immutable snapshot at publish time
  changeSummary   String? // why this revision exists (required on re-publish)
  aiAssisted      Boolean @default(false) // §24/§26 provenance snapshot
  publishedById   String?
  publishedAt     DateTime @default(now())

  mockTest    MockTest   @relation("MockTestRevisions", fields: [mockTestId], references: [id], onDelete: Cascade)
  publishedBy User?      @relation("MockTestRevisionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  liveFor     MockTest[] @relation("LiveMockTestRevision")

  @@unique([mockTestId, revisionNumber])
  @@index([mockTestId, publishedAt])
}

// §6 TestAttempt: "A user's attempt at a MockTest or Quiz" — id, user_id,
// mock_test_id, started_at, submitted_at, answers[], score, per-question
// correctness. The attempt SNAPSHOT-CARRIES the deal it was started under
// (composition served, duration, pass criteria — deadlineAt = startedAt +
// duration): a later correction of the test never rewrites history. SUBMITTED
// attempts are immutable — they are the §9 implicit signal + §22 mastery
// source that P7-S4 consumes.
//
// P7-S5 §22 combined-exam mode: mock_test_id is NULL for a GENERATED quick
// mock — an attempt scoped to "everything relevant across my followed exams"
// (§22) or one exam (§11 single-exam mode: the same union engine, one exam in
// the input set). A generated attempt carries generatedScopeJson instead (the
// §36-spirit snapshot of the scope it was built from); the service enforces
// exactly-one-anchor (an editorial attempt always has mockTestId, a generated
// one never does). Editorial rows are untouched by the widening.
model TestAttempt {
  id         String           @id @default(cuid())
  userId     String
  // §11: the combined view is COMPUTED, never a separately stored syllabus —
  // so a quick mock anchors on its SCOPE SNAPSHOT, not a stored MockTest row
  // (null iff this attempt was generated by the §22 combined-exam mode).
  mockTestId String?
  status     TestAttemptStatus @default(IN_PROGRESS)
  startedAt  DateTime         @default(now())
  // startedAt + the test's durationMinutes snapshot — the server-side truth
  // the submit endpoint enforces (§22 timed assessment; a client timer is
  // only presentation).
  deadlineAt  DateTime
  // Snapshots of the deal at start (§6/§36 spirit): what was served, how
  // long, at what pass criteria.
  servedQuestionsJson String // ordered Question ids served (the live revision's composition at start)
  durationMinutes     Int
  passPercent         Int
  // §22/P7-S5 — set iff mockTestId is null: {mode:'COMBINED'|'EXAM',
  // exams:[{slug,name,code}], questionCount, unitCount, generatedAt} — the
  // scope a generated quick mock was built from, frozen at start.
  generatedScopeJson  String?
  submittedAt         DateTime?
  // §6 answers[] — the per-question record, set once at submit:
  // [{questionId, selected, correct, correctAnswer, revisionNumber}].
  answersJson String // empty array while IN_PROGRESS
  // §6 score — derived once at submit, then immutable.
  correctCount Int?
  totalCount   Int?
  scorePercent Float?
  passed       Boolean?

  user     User      @relation("UserAttempts", fields: [userId], references: [id], onDelete: Cascade)
  mockTest MockTest? @relation("AttemptMockTest", fields: [mockTestId], references: [id], onDelete: Cascade)

  @@index([userId, mockTestId, status])
  @@index([mockTestId, status])
  @@index([userId, status])
  // P8-S4 §32 Learning: the platform-wide completion read (attempt status
  // distribution — the ShareEvent [createdAt] precedent of adding the read
  // the analytics family needs, without touching earlier semantics).
  @@index([status])
  // P8-S4 §32 Learning: windowed flow reads (submitted attempts in a time
  // window; submittedAt is null while IN_PROGRESS so the index skips them).
  @@index([submittedAt])
}

// ---------- P7-S4: MasteryState (Master Plan §6 row, §22, §9/§31) ----------

// §6 MasteryState: "Per-user, per-Knowledge-Unit/topic proficiency — user_id,
// knowledge_unit_id, mastery_score, last_reviewed_at, next_review_at". One
// row per user × canonical unit, written EXCLUSIVELY by the submit path of a
// §6 TestAttempt (§22: "Mastery state per Knowledge Unit/topic, derived from
// TestAttempt history") — one submitted attempt updates every unit it
// touched, exactly once, inside the attempt's claim transaction.
//
// mastery_score is the user's overall accuracy on the unit across submitted
// attempts (correctCount/attemptedCount — plain, explainable §9), NOT a
// proprietary black box. streak counts consecutive perfect rounds (every
// served question on the unit answered correctly) and drives §22 spaced
// review: intervals 1 → 3 → 7 → 14 → 30 → 60 days; ANY wrong or unanswered
// answer resets the streak and schedules tomorrow. next_review_at is the
// revision queue's due date.
//
// §36: the row is derived honest history — a RETIRED unit keeps its mastery
// rows (they render with the unit's honest status). §30/§31: rows cascade
// with the user account; the explicit "reset personalisation" control clears
// them (a §9 implicit signal) while the immutable attempts stay — new
// attempts rebuild mastery from that point on.
model MasteryState {
  id              String   @id @default(cuid())
  userId          String
  knowledgeUnitId String
  // §6 mastery_score — overall accuracy 0–100 (1 decimal).
  masteryScore    Float
  // Running tallies across every submitted attempt that served this unit.
  attemptedCount Int
  correctCount   Int
  // §22 spaced-review scheduler input — consecutive all-correct rounds.
  streak Int @default(0)
  // §6 last_reviewed_at — the most recent submitted attempt touching the unit.
  lastReviewedAt DateTime
  // §6 next_review_at — the spaced-review due date (the revision queue's key).
  nextReviewAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User          @relation("UserMastery", fields: [userId], references: [id], onDelete: Cascade)
  knowledgeUnit KnowledgeUnit @relation("UnitMastery", fields: [knowledgeUnitId], references: [id])

  // The §6 per-user-per-unit identity — upserts are idempotent at the storage layer.
  @@unique([userId, knowledgeUnitId])
  // The revision queue's hot read: my units ordered by due date.
  @@index([userId, nextReviewAt])
  @@index([knowledgeUnitId])
}

// ---------- P8-S1: the §21 sharing system ----------

// The §21 shareable canonical surfaces. Every value names the object a share
// action can target — the same vocabulary the share-path parser accepts and
// the share-card resolver serves (§37 stable resource identifiers: the PUBLIC
// ref — slug for unit/event/topic/exam, id for question/collection — never an
// internal-only identifier a client cannot reconstruct).
enum ShareObjectType {
  KNOWLEDGE_UNIT // the §16 knowledge page (…/gk/{topic}/{unit}/)
  CURRENT_EVENT // the §16 current-affairs page (…/current-affairs/{slug}/)
  TOPIC // the §33/§16 topic hub (…/gk/{topic}/)
  EXAM // the §16 exam page (…/exams/{exam}/)
  QUESTION // one §22 scored practice question (its unit page + ?q={id})
  COLLECTION // a §10 collection the owner explicitly made shareable (§21)
}

// §21 "track share events as analytics events": a share action created by a
// user, or a landing visit on a shareable canonical page. NOT a substitute
// for real social-network analytics (§21) — the platform records ITS OWN
// actions (shares made, arrivals), never what networks did with them.
enum ShareEventAction {
  SHARE_CREATE
  SHARE_LANDING
}

// How the share reached the user's clipboard/share sheet. Required on
// SHARE_CREATE; null on SHARE_LANDING (a landing has no channel).
enum ShareChannel {
  WEB_SHARE // the Web Share API path (§21)
  COPY_LINK // the copy-link fallback (§21)
}

// One §21 share event (§32 "Sharing: share actions, landing visits").
// Append-only analytics — no natural unique key, never updated, counts via
// the indexed reads. objectRef is the PUBLIC stable ref of the shared object
// (slug or id — §37); the full §16 path is reconstructable from type + ref +
// market, so the row stays honest across slug-stable edits (§36 revisions
// never change identity). userId is null for anonymous sharers/visitors
// (§31 data minimisation — no identity is needed to count a share); rows
// cascade with the user (§30/§31 — account deletion removes attributed
// events, anonymous history stays aggregate).
model ShareEvent {
  id         String           @id @default(cuid())
  objectType ShareObjectType
  objectRef  String
  action     ShareEventAction
  channel    ShareChannel?
  userId     String?
  // The §35 market the shared path carried (null when unknown/anonymous-root).
  countryIso String?
  createdAt  DateTime         @default(now())

  user User? @relation("UserShareEvents", fields: [userId], references: [id], onDelete: Cascade)

  // The §32 sharing-metric reads: per-object share counts + landing counts.
  @@index([objectType, objectRef, action])
  // Per-user attribution reads (the §9 inventory count).
  @@index([userId, createdAt])
  // Time-windowed analytics reads (P8-S4/S5 consume this).
  @@index([createdAt])
}

// ---------- P8-S2: the §27 notifications engine ----------

// §27 channels — "email, web-push, and mobile-push (mobile-push modeled
// now, implemented once the app exists — Section 4)". Channel-agnostic by
// design: the engine fans a trigger out per enabled channel; the transport
// layer decides delivery. MOBILE_PUSH rows are modeled (preferences + events
// carry them) but no mobile transport exists until the app ships (§39).
enum NotificationChannel {
  EMAIL
  WEB_PUSH
  MOBILE_PUSH
}

// §27 "status (queued/sent/failed/read)": QUEUED at fan-out; the dispatch
// step moves QUEUED → SENT (or FAILED, retryable); READ is the in-app
// reading surface's terminal state — a row the user reads before dispatch
// never delivers (pull-model honesty: seen is seen).
enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}

// §27 trigger types (non-exhaustive, extendable): the four reader triggers
// (current-affairs coverage on followed exams/topics, new syllabus units,
// spaced-review revision, corrections to saved items) + the editorial trio
// (task assigned, review requested, feedback report received — the feedback
// trigger wired in P8-S3: every submitted ContentFeedback report fans out to
// the owning workspace's editors).
enum NotificationTriggerType {
  CA_ITEM_FOLLOWED // a current-affairs item's first published representation, matched to a followed exam/topic
  UNIT_ADDED_FOLLOWED_EXAM // a KnowledgeUnit verified into a followed exam's syllabus coverage
  REVISION_DUE // the §22 spaced-review schedule: units due (from MasteryState)
  CORRECTION_PUBLISHED // a §25/§36 correction went live on a unit the user saved
  EDITORIAL_TASK_ASSIGNED // §27 editorial: a work item was assigned
  EDITORIAL_REVIEW_REQUESTED // §27 editorial: a review-type work item was assigned
  FEEDBACK_REPORT_RECEIVED // §27/§25 editorial: a ContentFeedback report arrived (wired P8-S3 — the report's workspace editors)
}

// The triggering object's type — what objectRef points at (a stable PUBLIC
// ref: slug for events/units, id for tasks/reports — §37). REVISION_DUE's
// object is the user's own revision queue (objectRef = their user id): the §22
// aggregate has no other public identity. CONTENT_FEEDBACK rows point at the
// report's id (P8-S3 §25 — the editorial workspace surface).
enum NotificationObjectType {
  CURRENT_EVENT
  KNOWLEDGE_UNIT
  EDITORIAL_TASK
  USER_MASTERY
  CONTENT_FEEDBACK
}

// One §6 NotificationEvent row — "A triggered, queued notification": ONE
// channel of ONE notification for ONE user. batchId groups the channel rows
// of a single notification instance (the in-app surface reads/writes whole
// notifications: one fan-out = one batch; mark-read marks the batch).
// contextJson is the §27 explainable payload — the complete reason sentence
// inputs: matched follows (with their one-tap mute paths), titles, labels,
// the §16 canonicalPath to reopen the object, due counts. It is a snapshot
// at trigger time (§36-honest: the notification says what was true when it
// fired, like a share card — not a live view).
model NotificationEvent {
  id          String                 @id @default(cuid())
  userId      String
  // Groups this notification's channel rows (one fan-out shares one id).
  batchId     String
  triggerType NotificationTriggerType
  objectType  NotificationObjectType
  objectRef   String
  channel     NotificationChannel
  status      NotificationStatus     @default(QUEUED)
  contextJson Json
  createdAt   DateTime               @default(now())
  sentAt      DateTime?
  readAt      DateTime?

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  // The notification-center reads: recent rows newest-first.
  @@index([userId, createdAt])
  // Batch reads/writes (mark-read, per-notification grouping).
  @@index([userId, batchId])
  // The unread-exists dedup read (REVISION_DUE idempotency) + per-category
  // unread counts.
  @@index([userId, triggerType, status])
  // The dispatch sweep's QUEUED scans.
  @@index([status, createdAt])
  // Per-object fan-out history (the §32 editorial/notification analytics).
  @@index([triggerType, objectRef])

  @@index([createdAt])
}

// One §6 NotificationPreference row — per-user, per-channel, per-category
// opt-in state (§27: "never all-or-nothing"). Sparse by design: NO row =
// the category's default (EMAIL/WEB_PUSH on, MOBILE_PUSH off — mobile-push
// has no transport until the app exists, so it never defaults on). Rows
// exist only where the user made an explicit choice; re-enabling after an
// opt-out writes enabled = true (the honest explicit state, not a delete).
model NotificationPreference {
  id        String             @id @default(cuid())
  userId    String
  channel   NotificationChannel
  // The §27 category key (see NOTIFICATION_CATEGORIES in the notifications
  // module — the shared vocabulary; a string column so categories can be
  // added without a migration, like SavedObjectType's additive growth).
  category  String
  enabled   Boolean
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User @relation("UserNotificationPreferences", fields: [userId], references: [id], onDelete: Cascade)

  // The effective-state upsert key (one row per user × channel × category).
  @@unique([userId, channel, category])
  // The fan-out's channel resolution read.
  @@index([userId, category])
}

// ---------- P8-S3: the §25 content feedback / quality loop ----------

// §25: "Every public content object has a lightweight 'Report an issue'
// action." The reportable set is spec-exact — the five public content
// object types §25 names (Knowledge page = the unit, a specific ContentItem
// representation, a QnA entry, a practice Question, a CurrentEvent). Mock
// tests are assessment configuration, not factual content — honestly out of
// scope. Refs follow each object's public identity (slug for units/events,
// id for content items/QnA/questions — the SavedItem precedent).
enum FeedbackObjectType {
  KNOWLEDGE_UNIT // the canonical record (§7) — issues on the knowledge itself
  CONTENT_ITEM // a specific published language × format representation
  CURRENT_EVENT // the event record / its §16 page
  QNA // a §22 practice Q&A entry
  QUESTION // a §22 scored practice question
}

// §25's four report reasons (verbatim from the spec: factual_error, outdated,
// translation_issue, other).
enum FeedbackType {
  FACTUAL_ERROR
  OUTDATED
  TRANSLATION_ISSUE
  OTHER
}

// Report lifecycle. OPEN (submitted, routed into §19) → IN_REVIEW (an editor
// is working the linked CORRECTION task) → RESOLVED (fixed — carries the
// resolution note, resolvedBy/resolvedAt per §6) or DISMISSED (reviewed, not
// an issue / won't fix — still carries the note: auditable to resolution
// either way, §44). Terminal states never delete (§36 migration-safe); a
// NEW report on the same object is always fileable.
enum FeedbackStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

// One §6 ContentFeedback row — a user-reported error/quality signal on a
// public content object. This is a QUALITY signal, never a personalisation
// signal and never a public "rating" (§25: a moderation/correction queue —
// report counts are never exposed publicly, only to the editorial queue and
// the reporter's own view). userId is NULL for anonymous reports (the §21
// ShareEvent anonymous-friendly precedent: browse-first users can flag
// errors without an account; the id attaches when signed in). Each report
// routes into the §19 editorial workflow as a CORRECTION EditorialTask
// (taskId) created at submission; resolving the task cascades back here.
model ContentFeedback {
  id             String            @id @default(cuid())
  // NULL = anonymous report (§21 precedent); SetNull on account deletion —
  // the report outlives the reporter (§31: the quality loop is content
  // data, not account data).
  userId         String?
  objectType     FeedbackObjectType
  // The canonical row id (the SavedItem precedent): the public ref that was
  // submitted — slug for units/events, id for items/QnA/questions — resolves
  // to the row ONCE, at submission.
  objectId       String
  // Display snapshot at report time (§36-honest, like a task objectLabel):
  // e.g. "Fundamental Rights — Articles 12–35 · en/EXPLAINER".
  objectLabel    String
  // The language of the reported representation where known (the
  // translation_issue signal; null for language-less objects).
  languageCode   String?
  feedbackType   FeedbackType
  // The reporter's description (min 10 chars — a report says what's wrong).
  description    String
  status         FeedbackStatus    @default(OPEN)
  // The §19/§25 link: the CORRECTION task this report routed into.
  taskId         String? @unique
  resolutionNote String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user       User?          @relation("UserContentFeedback", fields: [userId], references: [id], onDelete: SetNull)
  resolvedBy User?          @relation("UserResolvedContentFeedback", fields: [resolvedById], references: [id], onDelete: SetNull)
  task       EditorialTask? @relation("FeedbackReportTask", fields: [taskId], references: [id])

  // The editorial queue read (status-ordered, newest-first within status).
  @@index([status, createdAt])
  // Per-object report history (the §32 content metrics + dup checks).
  @@index([objectType, objectId])
  // The reporter's own-reports view (§31 own-data visibility).
  @@index([userId, createdAt])
  // The type-priority triage read (§26 severity triage).
  @@index([feedbackType, status])
  // P8-S4 §32 Content: the windowed time-to-correct read (resolved reports
  // in a time window — resolvedAt is the §44 resolution moment; null rows
  // skip the index, exactly like submittedAt on TestAttempt).
  @@index([resolvedAt])
}

// ---------- P8-S4: product analytics (Master Plan §32) ----------

// §32 Discovery ("search success"): one row per completed §17 public search
// query, written by the search service when the response is built (P8-S4's
// ONLY new instrumentation — every other §32 product family reads stores
// earlier sessions already write: ShareEvent, NotificationEvent,
// ContentFeedback, TestAttempt/MasteryState, UserFollow/SavedItem, sources).
//
// Deliberately ANONYMOUS-ONLY — a stronger §31 stance than ShareEvent (which
// attributes when a token rides the request): search is a per-QUERY surface
// (§17 explains every match on its own merits), so no userId column exists
// at all. A row can never become a search profile, the §31 reset never needs
// to touch it, and a failed search says nothing about who failed — that is
// the point. resultCount is the honest success input (§32 "search success"
// = the share of queries with ≥ 1 result); zero-result rows are KEPT — they
// are the honest gap list (the P8-S5 query-coverage input). topResultType
// snapshots what the first hit was (null on zero results). Append-only like
// ShareEvent: no natural unique key, never updated, counts via indexed reads.
model SearchQueryLog {
  id            String   @id @default(cuid())
  // The submitted q, exactly as the reader typed it (schema-validated).
  queryText     String
  // The §17 pagination.total of the completed query.
  resultCount   Int
  // The first hit's objectType — the "what did they find" snapshot.
  topResultType String?
  // The §35 market the query ran in (always IN today; the P9 launch
  // countries extend this without schema change — data-driven per §35).
  countryIso    String
  // The reader's resolved language (hi→hindi config etc., §17/§35).
  languageCode  String
  // The §17 type filter active on the query (null = the default 'all').
  typeFilter    String?
  // The §8 exam filter's slug (null when none was active).
  examRef       String?
  createdAt     DateTime @default(now())

  // Time-windowed §32 reads (the ShareEvent [createdAt] precedent).
  @@index([createdAt])
  // The per-market discovery read (§35 markets served).
  @@index([countryIso, createdAt])
  // The zero-result gap list (resultCount = 0, newest first).
  @@index([resultCount, createdAt])
}

// ---------- P8-S5: SEO + growth instrumentation (§32 SEO family, §33, §16, §31) ----------

// Both stores below are owned by the SEO module (§28): it owns the public
// acquisition measurement — the sitemap census (P4-S4) and now the arrival
// census (LandingEvent) and the engine-side observation import
// (SeoObservation). The analytics module only READS them (the P8-S4 rule:
// the producing module owns its event store).

// The anonymous arrival census. ONE row per page load, written best-effort
// by the app-shell beacon (POST /api/seo/landings) after the surface is
// classified SERVER-SIDE from the §16 path. Deliberately ANONYMOUS-ONLY —
// the SearchQueryLog stance (no userId column exists at all): an arrival
// can never become a profile, and the §31 reset never needs to touch it.
// The referrer is classified IN THE BROWSER (search / social / direct /
// other) — the raw referrer URL never leaves the device (§31: a referrer
// can carry personal data; only the class crosses the wire).
enum LandingSurface {
  HOME // #/ — the country homepage (§34)
  TOPIC // …/gk/{topic}/ — the §33 topic hub
  KNOWLEDGE // …/gk/{topic}/{unit}/ — the §22 knowledge page
  QUESTION // a unit page with the ?q= practice focus (§22, P8-S1)
  CURRENT_AFFAIRS // …/current-affairs/{slug}/ (§12/§16)
  EXAM // …/exams/{exam}/ (§16)
  SYLLABUS // …/exams/{exam}/syllabus/{topic}/ (§16)
  MOCK_TEST // the §22 runner (app-gated page, still a real arrival)
  COLLECTION // the §21 unlisted shared-collection landing
  APP // every in-app/private view (dashboard, console, profile…) — an
       // arrival is an arrival; the census records it honestly
}

enum LandingReferrer {
  DIRECT // no referrer or same-origin
  SEARCH // a known search-engine host
  SOCIAL // a known social/messaging host
  OTHER // any other external referrer — never the URL itself
}

model LandingEvent {
  id            String          @id @default(cuid())
  surface       LandingSurface
  referrerClass LandingReferrer
  // The §35 market the path resolved to (server-side, the §16 rules).
  countryIso    String
  createdAt     DateTime        @default(now())

  // Time-windowed §32 growth reads.
  @@index([createdAt])
  // The channel-mix read (referrer classes over time).
  @@index([referrerClass, createdAt])
  // The surface-mix read (which surfaces acquire).
  @@index([surface, createdAt])
}

// The engine-side observation import — Search Console-shaped daily rows
// (page × query × day: impressions, clicks, average position). The domain
// model stays vendor-neutral (§17's search-vendor rule applied to SEO
// data): the ingestion API (POST /api/seo/observations) accepts any feed
// that speaks this shape; P9-S4 wires the country-specific operations.
// pagePath is guarded against the LIVE §16 sitemap census — observations
// only ever land for paths the platform declares indexable (never a dead
// link, never a private surface). The unique key makes re-imports honest:
// re-pulling a day upserts that day's row (Search Console's own revision
// semantics), it never double-counts. No userId anywhere — this is a
// public-traffic census, anonymous by nature.
model SeoObservation {
  id          String   @id @default(cuid())
  // The observed day (Search Console granularity; the time component is
  // meaningless and normalized away on ingest).
  observedAt  DateTime
  countryIso  String
  // A §16 canonical path present in the live sitemap census.
  pagePath    String
  // The query as the ENGINE saw it (public search behavior, anonymous).
  queryText   String
  impressions Int
  clicks      Int
  // Average ranking position for the day (1.0 = first); null when the
  // feed omits it.
  avgPosition Float?
  createdAt   DateTime @default(now())

  @@unique([observedAt, countryIso, pagePath, queryText])
  // Windowed §32 SEO reads (impressions/clicks/CTR by day).
  @@index([observedAt])
  // Per-page reads (which pages earn the engine's traffic).
  @@index([pagePath, observedAt])
}
